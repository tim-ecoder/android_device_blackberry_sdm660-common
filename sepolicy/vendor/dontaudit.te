dontaudit system_app system_suspend_control_service:service_manager find;
dontaudit system_app system_suspend_control_internal_service:service_manager find;
dontaudit vendor_init default_prop:file read;
# Note: 'linkerconfig self:capability kill' is a coredomain denial — can't be
# silenced from vendor sepolicy. It's harmless / upstream cosmetic.
