typeattribute vendor_init data_between_core_and_vendor_violators;

allow vendor_init {
  dhcp_data_file
  media_userdir_file
  media_rw_data_file
  system_data_file
  tombstone_data_file
  wifi_data_file
}:dir { create search getattr open read setattr ioctl write add_name remove_name rmdir relabelfrom };

allow vendor_init media_rw_data_file:file getattr;
allow vendor_init fingerprintd_data_file:file { getattr relabelfrom relabelto };
allow vendor_init fingerprintd_data_file:dir { rw_file_perms create_file_perms };

set_prop(vendor_init, vendor_alarm_prop);
set_prop(vendor_init, vendor_camera_prop);
set_prop(vendor_init, vendor_dpm_prop);
get_prop(vendor_init, vendor_fingerprint_prop)
set_prop(vendor_init, vendor_radio_prop);
set_prop(vendor_init, audio_prop);

allow vendor_init build_prop:property_service set;
allow vendor_init default_prop:property_service set;
allow vendor_init radio_prop:property_service set;
allow vendor_init powerctl_prop:file read;

# init.qcom.rc 'symlink /dev/video0 /dev/msm_config' + chmod/chown
allow vendor_init audio_device:lnk_file { create setattr };

# Note: vendor_init reading init.svc.wpa_supplicant hits a private type
# (init_service_status_private_prop). Same for /data/misc/seemp dir
# (vendor_seemp_data_file in qcom legacy private). Cosmetic denials —
# can't be granted from vendor sepolicy, init falls back fine.
